# Razorpay Test Mode (dashboard.razorpay.com/app/keys — Test Mode ON)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Database
DATABASE_URL=postgresql+asyncpg://revive:revive@localhost:5432/revive_agent

# Redis / Celery (Day 5+)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Demo cool-down for delay_and_retry (production would use strategy timing_offset_minutes)
DELAY_RETRY_DEMO_SECONDS=30
DELAY_RETRY_USE_DEMO_COUNTDOWN=true

# LLM — default rules = zero Gemini latency (templates). Strategy never uses LLM.
# Opt in: LLM_PROVIDER=gemini + LLM_DRAFT_ENABLED=true (≤1 call, hard timeout).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=rules  # rules | gemini | ollama | openai
LLM_DRAFT_ENABLED=false
LLM_TIMEOUT_SECONDS=2.5

# Policy guard (IST quiet hours; comma-separated DNC customer ids)
POLICY_MAX_RETRIES=3
POLICY_QUIET_HOURS_START=22
POLICY_QUIET_HOURS_END=8
POLICY_DNC_CUSTOMER_IDS=

# App
APP_ENV=development
APP_DEBUG=true
APP_PORT=9000
CORS_ORIGINS=http://localhost:6100,http://localhost:6000,http://localhost:5173,http://localhost:3000

# DBeaver / local Postgres (same DB Compose exposes)
# Host=localhost  Port=5432  Database=revive_agent  User=revive  Password=revive  SSL=disable
