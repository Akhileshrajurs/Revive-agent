# Razorpay Test Mode (dashboard.razorpay.com/app/keys — Test Mode ON)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Database
DATABASE_URL=postgresql+asyncpg://revive:revive@localhost:5432/revive_agent

# Redis / Celery (Day 5+)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Demo cool-down for delay_and_retry (production would use strategy timing_offset_minutes)
DELAY_RETRY_DEMO_SECONDS=30
DELAY_RETRY_USE_DEMO_COUNTDOWN=true

# LLM — at most ONE Gemini call per recovery (comms draft only).
# Strategy is always rules-based (no LLM) for latency + free-tier RPM safety.
# Set LLM_DRAFT_ENABLED=false or LLM_PROVIDER=rules for zero Gemini calls (templates).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=gemini  # gemini | rules | ollama | openai
LLM_DRAFT_ENABLED=true

# App
APP_ENV=development
APP_DEBUG=true
APP_PORT=9000
CORS_ORIGINS=http://localhost:6100,http://localhost:6000,http://localhost:5173,http://localhost:3000

# DBeaver / local Postgres (same DB Compose exposes)
# Host=localhost  Port=5432  Database=revive_agent  User=revive  Password=revive  SSL=disable
